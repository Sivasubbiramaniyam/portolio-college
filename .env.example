# UCEN Faculty Portal — environment variable reference
#
# This file is an example and is NOT loaded automatically. The application reads
# real process environment variables with getenv(). Export them in your shell,
# Apache virtual host (SetEnv) or service manager before starting PHP.
#
# Do not put credentials or secrets in this file. Passwords are never stored in
# configuration; accounts are created with backend/bin/make-user.php.

# Application environment label and debug flag (debug is informational; stack
# traces are never sent to clients).
APP_ENV=production
APP_DEBUG=false

# Force the session cookie Secure flag. This is also set automatically when the
# request is HTTPS.
SESSION_COOKIE_SECURE=true

# Persistence and authentication providers: "mysql" (default) or "json".
# Set to "json" to fall back to the temporary JSON files in backend/storage/.
DATA_DRIVER=mysql
AUTH_USER_PROVIDER=mysql

# MySQL / MariaDB connection used by the "mysql" repositories.
# Create the schema with: php backend/bin/db-migrate.php
# Load the seed profiles with: php backend/bin/db-seed.php
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ucen_portal
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Optional sub-path prefix used by app_url() when the application is served
# from a subdirectory (for example /ucen). Leave empty for the web root.
APP_BASE_PATH=
